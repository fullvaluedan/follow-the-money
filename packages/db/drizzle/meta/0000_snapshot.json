      "definition": "select \"lawmakers\".\"id\", \"lawmakers\".\"bioguide_id\", \"lawmakers\".\"name\", \"lawmakers\".\"chamber\", \"lawmakers\".\"party\", \"lawmakers\".\"state\", count(\"trades\".\"id\") as \"n_trades\", round(avg(\"trades\".\"days_to_file\")::numeric, 1) as \"avg_days_to_file\", count(*) filter (where \"trades\".\"is_late\") as \"late_count\", round((count(*) filter (where \"trades\".\"is_late\")::numeric / greatest(count(\"trades\".\"id\"), 1)) * 100, 1) as \"late_rate\", max(\"trades\".\"tx_date\") as \"most_recent_tx\" from \"lawmakers\" left join \"trades\" on \"trades\".\"lawmaker_id\" = \"lawmakers\".\"id\" and \"trades\".\"status\" = 'published' group by \"lawmakers\".\"id\", \"lawmakers\".\"bioguide_id\", \"lawmakers\".\"name\", \"lawmakers\".\"chamber\", \"lawmakers\".\"party\", \"lawmakers\".\"state\"",
